        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ea%b8%b0%ec%96%b4%eb%a6%ac%ec%8a%a4-%ec%97%98%eb%a6%ac%eb%b2%a0%ec%9d%b4%ed%84%b0-%ea%b2%ac%ec%9d%b8%ea%b8%b0-%ec%b5%9c%ec%8b%a0-pmsm-%ec%86%94%eb%a3%a8%ec%85%98&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
