        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ed%81%ac%eb%a0%88%ec%9d%b8-%eb%b6%80%ed%92%88-%ec%9a%94%ea%b5%ac%eb%a5%bc-%ec%9c%84%ed%95%9c-%ec%a2%85%ed%95%a9-%ec%86%94%eb%a3%a8%ec%85%98&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
