      <description>&lt;h2 class=&#34;relative group&#34;&gt;多元化起重機與吊車產品影片集錦 
    &lt;div id=&#34;多元化起重機與吊車產品影片集錦&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e5%a4%9a%e5%85%83%e5%8c%96%e8%b5%b7%e9%87%8d%e6%a9%9f%e8%88%87%e5%90%8a%e8%bb%8a%e7%94%a2%e5%93%81%e5%bd%b1%e7%89%87%e9%9b%86%e9%8c%a6&#34; aria-label=&#34;定位點&#34;&gt;#&lt;/a&gt;
